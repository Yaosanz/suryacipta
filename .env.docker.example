# Public HTTPS URLs. Do not add a trailing slash.
FRONTEND_URL=https://suryaciptaestetika.co.id
BACKEND_URL=https://api.suryaciptaestetika.co.id

# Generate with: php artisan key:generate --show
APP_KEY=

# Production database credentials — Managed MySQL dari Dokploy.
# DB_HOST adalah hostname internal yang tampil di halaman Database Dokploy.
DB_HOST=suryacipta-suryacipta-iztnsy
DB_PORT=3306
DB_DATABASE=suryacipta
DB_USERNAME=mysql
DB_PASSWORD=

# Public build-time settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=6281282333021
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# Enable only after a real production mail provider is configured.
CMS_PASSWORD_RESET_ENABLED=false
